+bool RendererImpl::SupportsFastForward(base::TimeDelta /* media_time */) const {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  const bool waiting_for_data = WaitingForEnoughData();
+  // Allow fast-forward when playing, or when paused but a video renderer exists
+  // (covers both video-only and audio+video). The !waiting_for_data guard below
+  // ensures both renderers already have HAVE_ENOUGH before we skip a full flush.
+  const bool result =
+      state_ == STATE_PLAYING &&
+      (playback_rate_ > 0 || !!video_renderer_) &&
+      !waiting_for_data;
+  return result;
+}
+
+void RendererImpl::FastForwardTo(base::TimeDelta media_time,
+                                 PipelineStatusCallback seek_done_cb) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  DCHECK_EQ(state_, STATE_PLAYING);
+
+  const bool restart_ticking = time_ticking_;
+  if (time_ticking_) {
+    time_ticking_ = false;
+    time_source_->StopTicking();
+    if (playback_rate_ > 0 && video_renderer_)
+      video_renderer_->OnTimeStopped();
+  }
+  time_source_->SetMediaTime(media_time);
+
+  // Wait for all sub-renderers.
+  if (!audio_renderer_ && !video_renderer_) {
+    CompleteFastForwardTo(restart_ticking, std::move(seek_done_cb));
+    return;
+  }
+
+  // Wrap seek_done_cb in a BarrierClosure so it fires once both audio and video
+  // have finished discarding data before |media_time|.
+  int count = (audio_renderer_ ? 1 : 0) + (video_renderer_ ? 1 : 0);
+  base::RepeatingClosure barrier = base::BarrierClosure(
+      count,
+      base::BindOnce(&RendererImpl::CompleteFastForwardTo, weak_this_,
+                     restart_ticking, std::move(seek_done_cb)));
+
+  if (audio_renderer_)
+    audio_renderer_->FastForwardTo(media_time, barrier);
+  if (video_renderer_)
+    video_renderer_->FastForwardTo(media_time, barrier);
+}
+
+void RendererImpl::CompleteFastForwardTo(
+    bool restart_ticking,
+    PipelineStatusCallback seek_done_cb) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+  if (state_ != STATE_PLAYING) {
+    std::move(seek_done_cb).Run(PIPELINE_ERROR_INVALID_STATE);
+    return;
+  }
+
+  const bool have_enough = !WaitingForEnoughData();
+  std::move(seek_done_cb).Run(PIPELINE_OK);
+
+  // WebMediaPlayerImpl::DoSeek() reduces the ready state when a seek starts.
+  // The fast-forward path can keep renderers in HAVE_ENOUGH, so re-announce
+  // that state after the seek completes.
+  if (have_enough) {
+    client_->OnBufferingStateChange(BUFFERING_HAVE_ENOUGH,
+                                    BUFFERING_CHANGE_REASON_UNKNOWN);
+  }
+
+  if (restart_ticking && !time_ticking_ && have_enough) {
+    time_ticking_ = true;
+    time_source_->StartTicking();
+    if (playback_rate_ > 0 && video_renderer_)
+      video_renderer_->OnTimeProgressing();
+  }
+}
+
