+template <DemuxerStream::Type StreamType>
+void DecoderStream<StreamType>::FastForwardTo(base::TimeDelta target_time) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+  base::TimeDelta drop_before_timestamp = target_time;
+  const base::TimeDelta average_duration = AverageDuration();
+  if constexpr (StreamType == DemuxerStream::VIDEO) {
+    if (average_duration.is_positive()) {
+      drop_before_timestamp =
+          std::max(base::TimeDelta(), target_time - average_duration);
+    } else {
+      drop_before_timestamp = kNoTimestamp;
+    }
+  }
+
+  // Remove stale outputs before the selected drop threshold.
+  if (drop_before_timestamp != kNoTimestamp) {
+    while (!ready_outputs_.empty() &&
+           ready_outputs_.front()->timestamp() < drop_before_timestamp) {
+      ready_outputs_.pop_front();
+    }
+    while (!unprepared_outputs_.empty() &&
+           unprepared_outputs_.front()->timestamp() < drop_before_timestamp) {
+      unprepared_outputs_.pop_front();
+    }
+  }
+
+  // Frames already being produced by the decoder will be filtered in
+  // OnDecodeOutputReady().
+  drop_before_timestamp_ = drop_before_timestamp;
+
+  // Align the GPU-preparation skip window so that frames just before
+  // |target_time| don't incur an unnecessary shared-image upload.
+  skip_prepare_until_timestamp_ = target_time;
+}
