+bool FFmpegDemuxer::ShouldFastForward(base::TimeDelta media_time) const {
+  // Prefer video stream as reference; fall back to audio.
+  const FFmpegDemuxerStream* ref_stream =
+      GetFirstEnabledFFmpegStream(DemuxerStream::VIDEO);
+  if (!ref_stream)
+    ref_stream = GetFirstEnabledFFmpegStream(DemuxerStream::AUDIO);
+  if (!ref_stream)
+    return false;
+
+  // Data still queued in the demuxer can be consumed without an FFmpeg seek.
+  // Do not use GetBufferedRanges() here: it is historical buffered metadata and
+  // may include packets already handed off to downstream decoders.
+  if (ref_stream->HasQueuedPacketFor(media_time))
+    return true;
+
+  // Targets near the read head can be reached without a full FFmpeg seek:
+  // behind it by dropping already-read data, or ahead by reading forward.
+  const base::TimeDelta last_read = ref_stream->GetLastPacketTimestamp();
+  if (last_read == kNoTimestamp)
+    return false;
+
+  constexpr base::TimeDelta kMaxReadAhead = base::Seconds(5);
+  if (media_time <= last_read) {
+    return (last_read - media_time) <= kMaxReadAhead;
+  }
+
+  constexpr base::TimeDelta kMaxLookahead = base::Seconds(2);
+  return (media_time - last_read) <= kMaxLookahead;
+}
