+void VideoRendererAlgorithm::DiscardFramesBefore(base::TimeDelta time) {
+  // Count how many leading frames do not extend past |time|, but always keep at
+  // least one so Render() has something to return while the pipeline refills.
+  size_t to_discard = 0;
+  for (; to_discard + 1 < frame_queue_.size(); ++to_discard) {
+    const auto& frame = frame_queue_[to_discard].frame;
+    base::TimeDelta duration =
+        frame->metadata().frame_duration.value_or(base::TimeDelta());
+    if (!duration.is_positive()) {
+      duration = frame_queue_[to_discard + 1].frame->timestamp() -
+                 frame->timestamp();
+    }
+
+    if (!duration.is_positive() || frame->timestamp() + duration > time)
+      break;
+  }
+
+  if (!to_discard)
+    return;
+
+  // Advance the cadence counter in step with RemoveExpiredFrames() so that
+  // cadence-based ideal-render-count tracking remains consistent.
+  cadence_frame_counter_ += to_discard;
+  frame_queue_.erase(frame_queue_.begin(), frame_queue_.begin() + to_discard);
+
+  // Retained frames may have render/drop counts from the old seek position.
+  // Reset them so cadence selection can use the retained frame immediately.
+  for (auto& rf : frame_queue_) {
+    rf.render_count = 0;
+    rf.drop_count = 0;
+  }
+
+  last_deadline_max_ = base::TimeTicks();
+
+  // Recompute the effective-frames count now that the queue has shrunk.
+  UpdateEffectiveFramesQueued();
+}
+
+bool VideoRendererAlgorithm::HasFrameForTime(base::TimeDelta time) const {
+  for (size_t i = 0; i < frame_queue_.size(); ++i) {
+    const auto& frame = frame_queue_[i].frame;
+    base::TimeDelta duration =
+        frame->metadata().frame_duration.value_or(base::TimeDelta());
+    if (!duration.is_positive() && i + 1 < frame_queue_.size()) {
+      duration = frame_queue_[i + 1].frame->timestamp() - frame->timestamp();
+    }
+
+    if (duration.is_positive()) {
+      if (frame->timestamp() <= time && time < frame->timestamp() + duration)
+        return true;
+      if (frame->timestamp() > time)
+        return true;
+      continue;
+    }
+
+    if (i + 1 >= frame_queue_.size() && frame->timestamp() <= time)
+      return true;
+
+    if (frame->timestamp() > time)
+      return true;
+  }
+  return false;
+}
